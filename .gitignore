# Every episode is tracked from the time its Goal is proposed. Large data and
# transient runtime files are excluded by the rules below.

# Inputs are durable OAK data/pointers, not part of the lightweight root repo.
# Keep only the small README that preserves the directory in a fresh clone.
/*/inputs/*
!/*/inputs/README.md
!/episode01_narps_deep_search/inputs/prior_lineage/
!/episode01_narps_deep_search/inputs/prior_lineage/PRIOR_LINEAGE_MANIFEST.json
/episode01_narps_deep_search/inputs/prior_lineage/materialized/

# Relocated legacy NARPS prior records retain large local-only payloads. These
# nested paths need explicit rules because the generic episode rules above
# intentionally match only direct children of the repository root.
/_examples/historical_prior_records/episode01_narps_analysis/inputs/*
/_examples/historical_prior_records/episode02_narps_analysis/inputs/*
/_examples/historical_prior_records/episode01_narps_analysis/outputs/logs/
/_examples/historical_prior_records/episode01_narps_analysis/outputs/cache/
/_examples/historical_prior_records/episode01_narps_analysis/outputs/tmp/
/_examples/historical_prior_records/episode01_narps_analysis/outputs/subject_maps/
/_examples/historical_prior_records/episode01_narps_analysis/outputs/group_maps/
/_examples/historical_prior_records/episode02_narps_analysis/outputs/logs/
/_examples/historical_prior_records/episode02_narps_analysis/outputs/cache/
/_examples/historical_prior_records/episode02_narps_analysis/outputs/tmp/
/_examples/historical_prior_records/episode02_narps_analysis/outputs/subject_maps/
/_examples/historical_prior_records/episode02_narps_analysis/outputs/group_maps/
/*/outputs/logs/
/*/outputs/cache/
/*/outputs/tmp/
/*/outputs/subject_maps/
/*/outputs/group_maps/

# Credentials and local Codex runtime state.  Keep the project MCP config.
.env
.env.*
!.env.example
*.pem
*.key
/.codex/*
!/.codex/config.toml

# Transient Sherlock and Python state.
/scratch/
/tmp/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
*.tmp
slurm-*.out
slurm-*.err

# Large derived data belong in OAK episode storage, not the lightweight root repo.
.evaluator_vault/
*.nii
*.nii.gz
*.npy
*.npz
*.h5
*.hdf5
*.pkl
*.joblib
*.pt
*.ckpt
*.tar
*.tar.gz
*.zip
