{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autoresearch.episode_readiness.v1",
  "title": "Optional canonical-confirmation readiness projection (not a local launch gate)",
  "type": "object",
  "required": [
    "schema_version",
    "observed_on",
    "readiness_model_ref",
    "portfolio_blockers",
    "episodes"
  ],
  "properties": {
    "schema_version": {"const": "autoresearch.episode_readiness.v1"},
    "observed_on": {"type": "string", "minLength": 1},
    "readiness_model_ref": {"const": "READINESS_MODEL.yaml"},
    "canonical_authority": {"const": "Brain Researcher MCP"},
    "scope": {"const": "optional_canonical_confirmation_projection_not_local_launch"},
    "portfolio_blockers": {
      "type": "array",
      "items": {"$ref": "#/$defs/blocker"}
    },
    "active_episode_review": {"type": ["string", "null"]},
    "review_queue": {
      "type": "array",
      "items": {"type": "string", "pattern": "^ep(0[1-9]|1[0-9]|2[0-1])$"},
      "uniqueItems": true
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/episode"}
    }
  },
  "$defs": {
    "blocker": {
      "type": "object",
      "required": ["blocker_id", "class", "description"],
      "properties": {
        "blocker_id": {"type": "string", "minLength": 1},
        "class": {
          "enum": [
            "contract",
            "scientific_freeze",
            "source",
            "development_handoff",
            "audit_boundary",
            "trusted_evaluator",
            "exposure_ledger",
            "shared_evidence",
            "compute_profile",
            "identity_collision",
            "canonical_program",
            "external_data",
            "scope_decision"
          ]
        },
        "description": {"type": "string", "minLength": 1},
        "resolution_authority": {
          "enum": ["trusted_builder", "scientist", "canonical_service", "external_provider", "shared"]
        }
      },
      "additionalProperties": true
    },
    "episode": {
      "type": "object",
      "required": [
        "episode_id",
        "path",
        "readiness",
        "execution",
        "evidence",
        "compatibility",
        "blocking_classes",
        "next_gate"
      ],
      "properties": {
        "episode_id": {"type": "string", "pattern": "^ep(0[1-9]|1[0-9]|2[0-1])$"},
        "path": {"type": "string", "minLength": 1},
        "readiness": {
          "type": "object",
          "required": ["state"],
          "properties": {
            "state": {
              "enum": [
                "draft",
                "provisioning",
                "development_ready",
                "audit_ready",
                "canonical_preflight_ready",
                "canonical_ready",
                "invalidated"
              ]
            },
            "manifest_ref": {"type": ["string", "null"]}
          }
        },
        "execution": {
          "type": "object",
          "required": ["state"],
          "properties": {
            "state": {
              "enum": ["not_started", "development_running", "configuration_locked", "audit_opened", "terminal"]
            }
          }
        },
        "evidence": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {"enum": ["not_evaluated", "in_progress", "verified", "failed"]}
          }
        },
        "canonical_binding": {
          "type": ["object", "null"],
          "properties": {
            "authority": {"const": "Brain Researcher MCP"},
            "episode_id": {"type": "string", "pattern": "^ep(0[1-9]|1[0-9]|2[0-1])$"},
            "program_id": {"type": "string", "minLength": 1},
            "program_version": {"type": "string", "minLength": 1},
            "policy_ref": {"type": "string", "minLength": 1},
            "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "contract_revision": {"type": "integer", "minimum": 1},
            "contract_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "git_commit": {
              "oneOf": [
                {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              ]
            },
            "receipt_id": {"type": "string", "minLength": 1},
            "receipt_ref": {"type": "string", "minLength": 1},
            "verified_at": {"type": "string", "minLength": 1}
          },
          "required": ["authority", "episode_id", "program_id", "program_version", "policy_ref", "policy_sha256", "contract_revision", "contract_manifest_sha256", "git_commit", "receipt_id", "receipt_ref", "verified_at"],
          "additionalProperties": false
        },
        "compatibility": {
          "type": "object",
          "required": ["launch_blocked", "launch_eligible"],
          "properties": {
            "launch_blocked": {"type": "boolean", "description": "Legacy canonical-confirmation compatibility field; ignored by bin/codex-episode."},
            "launch_eligible": {"type": "boolean", "description": "Eligibility for the optional canonical lane, not episode-managed local launch."}
          }
        },
        "blocking_classes": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "next_gate": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"readiness": {"properties": {"state": {"const": "canonical_ready"}}}},
            "required": ["readiness"]
          },
          "then": {
            "required": ["canonical_binding"],
            "properties": {
              "canonical_binding": {
                "type": "object",
                "required": ["authority", "episode_id", "program_id", "program_version", "policy_ref", "policy_sha256", "contract_revision", "contract_manifest_sha256", "git_commit", "receipt_id", "receipt_ref", "verified_at"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "readiness": {"properties": {"state": {"const": "canonical_ready"}}},
              "execution": {"properties": {"state": {"const": "not_started"}}}
            },
            "required": ["readiness", "execution"]
          },
          "then": {
            "properties": {"compatibility": {"properties": {"launch_blocked": {"const": false}, "launch_eligible": {"const": true}}}}
          },
          "else": {
            "properties": {"compatibility": {"properties": {"launch_blocked": {"const": true}, "launch_eligible": {"const": false}}}}
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
