{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autoresearch.episode_readiness_manifest.v1",
  "title": "Episode-specific readiness manifest",
  "type": "object",
  "required": [
    "schema_version",
    "episode_id",
    "observed_on",
    "readiness_model_ref",
    "readiness_state",
    "execution_state",
    "evidence_status",
    "outcome_access_during_this_review",
    "summary_gates",
    "gates",
    "promotion_requirements",
    "next_action"
  ],
  "properties": {
    "schema_version": {"const": "autoresearch.episode_readiness_manifest.v1"},
    "episode_id": {"type": "string", "pattern": "^ep(0[1-9]|1[0-9]|2[0-1])$"},
    "observed_on": {"type": "string", "minLength": 1},
    "readiness_model_ref": {"type": "string", "minLength": 1},
    "readiness_state": {
      "enum": ["draft", "provisioning", "development_ready", "audit_ready", "canonical_preflight_ready", "canonical_ready", "invalidated"]
    },
    "execution_state": {
      "enum": ["not_started", "development_running", "configuration_locked", "audit_opened", "terminal"]
    },
    "evidence_status": {"enum": ["not_evaluated", "in_progress", "verified", "failed"]},
    "outcome_access_during_this_review": {"type": "string", "minLength": 1},
    "summary_gates": {
      "type": "object",
      "required": [
        "contract",
        "source_integrity",
        "scientific_freeze",
        "shared_evidence",
        "development_handoff",
        "controller",
        "audit_identity",
        "audit_boundary",
        "trusted_evaluator",
        "compute_profile",
        "identity_collision",
        "canonical_program"
      ],
      "additionalProperties": {"$ref": "#/$defs/gate"}
    },
    "gates": {"type": "object", "minProperties": 1},
    "promotion_requirements": {"type": "object", "minProperties": 1},
    "next_action": {"type": "object", "minProperties": 1}
  },
  "$defs": {
    "gate": {
      "type": "object",
      "required": ["status", "evidence_refs", "blocker_ids"],
      "properties": {
        "status": {"enum": ["passed", "blocked", "unknown", "not_applicable"]},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "blocker_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "rationale": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
