{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autoresearch.episode_registry.v3",
  "title": "Autoresearch episode identity registry",
  "type": "object",
  "required": ["schema_version", "episodes"],
  "properties": {
    "schema_version": {"const": "autoresearch.episode_registry.v3"},
    "registry_schema_ref": {"const": "EPISODE_REGISTRY.schema.json"},
    "observed_on": {"type": "string", "format": "date"},
    "contract_mode": {"const": "direct_single_current_version"},
    "numbering_policy": {"type": "object"},
    "historical_prior_records": {"type": "array"},
    "reserved_episode_ids": {"type": "array"},
    "incomplete_draft_records": {"type": "array"},
    "shared_evidence_groups": {"type": "array"},
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["episode_id", "path", "title", "search_policy_ref"],
        "properties": {
          "episode_id": {"type": "string", "pattern": "^ep(0[1-9]|1[0-9]|2[0-1])$"},
          "path": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "search_policy_ref": {"type": "string", "minLength": 1},
          "local_role": {"const": "current_adaptive_episode"},
          "prior_lineage_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
