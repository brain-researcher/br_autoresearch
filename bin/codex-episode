#!/usr/bin/env bash
# Start or resume one bounded, episode-managed autoresearch task on Sherlock.
# This wrapper starts Codex and snapshots the local contract bytes. Data checks,
# model validation, held-out evaluation, and terminal decisions happen inside
# the episode rather than acting as portfolio-level launch gates.

set -euo pipefail

usage() {
  printf '%s\n' >&2 \
    'Usage:' \
    '  bin/codex-episode launch <episode-dir>' \
    '  bin/codex-episode resume <episode-dir> <codex-session-id>' \
    '' \
    'The episode directory must be a direct child of this project root and contain:' \
    'GOAL.md, DATASETS.md, one SEARCH_POLICY.{yaml,json}, inputs/, and outputs/'
  exit 2
}

error() {
  printf 'codex-episode: %s\n' "$*" >&2
  exit 2
}

[[ $# -ge 2 ]] || usage

mode=$1
shift
case "$mode" in
  launch|resume) ;;
  *) usage ;;
esac

episode_arg=$1
shift

session_id=""
if [[ "$mode" == "resume" ]]; then
  [[ $# -ge 1 ]] || error "resume requires an explicit Codex session id"
  session_id=$1
  shift
  [[ -n "$session_id" ]] || error "resume requires an explicit Codex session id"
  [[ "$session_id" != -* ]] || error "resume requires an explicit session id, not a selector"
  [[ "$session_id" != *$'\n'* ]] || error "resume session id must be one line"
fi
[[ $# -eq 0 ]] || usage

root_dir=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

# Sherlock's system Git is old enough not to support `git -C`. Run Git from a
# subshell rooted at the project instead, preserving the caller's working
# directory and normal Git/worktree discovery.
git_in_root() (
  cd -P -- "$root_dir" || exit 1
  command git "$@"
)

if [[ "$episode_arg" == /* ]]; then
  episode_candidate=$episode_arg
else
  episode_candidate="$root_dir/$episode_arg"
fi
[[ -d "$episode_candidate" ]] || error "episode directory does not exist: $episode_candidate"
episode_dir=$(cd -P -- "$episode_candidate" && pwd)
[[ $(dirname -- "$episode_dir") == "$root_dir" ]] || \
  error "episode must be a direct child of $root_dir"

for required in GOAL.md DATASETS.md; do
  [[ -f "$episode_dir/$required" ]] || error "missing $required in $episode_dir"
  [[ ! -L "$episode_dir/$required" ]] || error "$required must not be a symlink"
done
policy_file=""
for policy_candidate in SEARCH_POLICY.yaml SEARCH_POLICY.json; do
  if [[ -f "$episode_dir/$policy_candidate" ]]; then
    [[ ! -L "$episode_dir/$policy_candidate" ]] || \
      error "$policy_candidate must not be a symlink"
    [[ -z "$policy_file" ]] || \
      error "episode contains both SEARCH_POLICY.yaml and SEARCH_POLICY.json"
    policy_file=$policy_candidate
  fi
done
[[ -n "$policy_file" ]] || \
  error "missing SEARCH_POLICY.yaml or SEARCH_POLICY.json in $episode_dir"
for required in inputs outputs; do
  [[ -d "$episode_dir/$required" ]] || error "missing $required/ in $episode_dir"
done

[[ ! -L "$episode_dir/outputs" ]] || error "outputs/ must not be a symlink"
outputs_dir=$(cd -P -- "$episode_dir/outputs" && pwd)
[[ "$outputs_dir" == "$episode_dir/outputs" ]] || error "outputs/ must remain inside the episode"

control_dir="$outputs_dir/.codex-episode"
lock_file="$outputs_dir/.codex-episode.lock"
[[ ! -L "$control_dir" ]] || error "local Codex control directory must not be a symlink"
[[ ! -L "$lock_file" ]] || error "local Codex lock must not be a symlink"

if [[ "$mode" == "launch" && -e "$episode_dir/outputs/candidate_bundle.json" ]]; then
  error "launch found outputs/candidate_bundle.json; resume the original session, or preserve it and start a new episode rather than overwriting it"
fi
if [[ "$mode" == "launch" && -e "$control_dir" ]]; then
  error "episode has a prior launch marker; resume the correct Codex session instead of starting a second episode task"
fi
episode_name=$(basename -- "$episode_dir")
command -v sha256sum >/dev/null 2>&1 || error "sha256sum is required for the contract snapshot"

[[ -n ${SCRATCH:-} ]] || error "SCRATCH must be set on Sherlock"
[[ "$SCRATCH" == /* ]] || error "SCRATCH must be an absolute path"
[[ -d "$SCRATCH" && -w "$SCRATCH" ]] || error "SCRATCH must already exist and be writable"
command -v codex >/dev/null 2>&1 || error "codex is not on PATH"
command -v flock >/dev/null 2>&1 || error "flock is required for episode session isolation"

scratch_root=$(cd -P -- "$SCRATCH" && pwd)
[[ "$scratch_root" != "/" ]] || error "SCRATCH must not resolve to filesystem root"
case "$scratch_root/" in
  "$root_dir"/*) error "SCRATCH must not resolve inside the OAK project" ;;
esac
scratch_parent="$scratch_root/autoresearch"
mkdir -p -- "$scratch_parent"
scratch_parent=$(cd -P -- "$scratch_parent" && pwd)
case "$scratch_parent/" in
  "$scratch_root"/*) ;;
  *) error "autoresearch scratch parent escaped SCRATCH" ;;
esac
scratch_dir="$scratch_parent/$episode_name"
mkdir -- "$scratch_dir" 2>/dev/null || [[ -d "$scratch_dir" ]] || \
  error "could not create episode scratch directory"
scratch_dir=$(cd -P -- "$scratch_dir" && pwd)
case "$scratch_dir/" in
  "$scratch_root"/*) ;;
  *) error "episode scratch directory escaped SCRATCH" ;;
esac

exec 9>"$lock_file"
flock -n 9 || error "another Codex process is already active for $episode_name"

launch_prompt() {
  printf '%s\n' \
    "Run the episode-managed autoresearch workflow for $episode_name." \
    '' \
    "The scientist explicitly invoked this launcher. That authorizes starting bounded work inside $episode_dir, but not publication claims, reward, or changes to sibling episodes." \
    "The immutable launch copies under $control_dir/contract record Git HEAD $contract_commit and SHA-256 values GOAL=$goal_sha256 DATASETS=$datasets_sha256 POLICY=$policy_sha256. A clean Git tree is not a prerequisite." \
    "Read the root AGENTS.md, then use $control_dir/contract/GOAL.md, DATASETS.md, and $policy_file as this run's contract. The live root files are authoring copies and may not silently replace the launch snapshot." \
    "Bootstrap, data-value checks, runtime checks, controller checks, falsification, held-out evaluation, and any audit semantics are episode stages. Perform and record them inside this task; do not wait for a portfolio readiness promotion, external evaluator, audit broker, or canonical receipt before beginning." \
    "If an internal prerequisite fails, repair it within scope when safe or terminate the episode with an explicit technical/no-candidate record. Never silently weaken the frozen scientific question, split, estimand, or decision rule." \
    "During outcome-blind episode design, optionally inspect clearly named Landscape or Self-evolvable Questions JSON already present under inputs/. If none are present, readable, or relevant, continue without them. Use them only for candidate recall, novelty, rival/control ideas, and claim boundaries; never treat them as evidence, Society decisions, typed idea-source lineage, or launch authority." \
    "Treat inputs/ as read-only. Write new scientific artifacts only under $episode_dir/outputs/. Initialize and maintain the seven outputs Markdown projections required by the project-local skill." \
    "Use $scratch_dir for transient work and Slurm for expensive computation. Brain Researcher/Society integration may be used later for review or claim governance, but it is not a launch prerequisite for this episode-managed run." \
    "Do not modify sibling episodes or root campaign documents. Report the episode's realized terminal state and all validation or held-out results without promoting them automatically into shared campaign claims."
}

resume_prompt() {
  printf '%s\n' \
    "Resume the existing episode-managed autoresearch task for $episode_name." \
    "Use the unchanged contract copies under $control_dir/contract; the launcher has verified that the live authoring files still match their recorded hashes." \
    "Keep the episode boundary: inputs/ is read-only; new scientific artifacts and the seven required Markdown projections belong only in $episode_dir/outputs/. Use $scratch_dir for transient work and Slurm for expensive computation." \
    "Continue the episode's own bootstrap, search, validation, held-out evaluation, and terminal protocol from its recorded state. Do not wait for a portfolio-level readiness or canonical gate." \
    "Do not modify sibling episodes or root campaign documents, and do not turn an internal result into a shared claim automatically."
}

common_args=(
  --cd "$episode_dir"
  --add-dir "$scratch_dir"
  --sandbox workspace-write
  --ask-for-approval on-request
)
if [[ -n ${BR_AUTORESEARCH_CODEX_MODEL:-} ]]; then
  common_args+=(--model "$BR_AUTORESEARCH_CODEX_MODEL")
fi

if [[ "$mode" == "launch" ]]; then
  mkdir -- "$control_dir" || \
    error "episode acquired a launch marker concurrently; use the recovery guidance from a fresh launch attempt"
  launch_state="$control_dir/state"
  snapshot_dir="$control_dir/contract"
  mkdir -- "$snapshot_dir"
  cp -- "$episode_dir/GOAL.md" "$snapshot_dir/GOAL.md"
  cp -- "$episode_dir/DATASETS.md" "$snapshot_dir/DATASETS.md"
  cp -- "$episode_dir/$policy_file" "$snapshot_dir/$policy_file"
  chmod a-w -- "$snapshot_dir/GOAL.md" "$snapshot_dir/DATASETS.md" "$snapshot_dir/$policy_file"
  goal_sha256=$(sha256sum "$snapshot_dir/GOAL.md" | awk '{print $1}')
  datasets_sha256=$(sha256sum "$snapshot_dir/DATASETS.md" | awk '{print $1}')
  policy_sha256=$(sha256sum "$snapshot_dir/$policy_file" | awk '{print $1}')
  [[ $(sha256sum "$episode_dir/GOAL.md" | awk '{print $1}') == "$goal_sha256" ]] || \
    error "GOAL.md changed while the launch snapshot was being created"
  [[ $(sha256sum "$episode_dir/DATASETS.md" | awk '{print $1}') == "$datasets_sha256" ]] || \
    error "DATASETS.md changed while the launch snapshot was being created"
  [[ $(sha256sum "$episode_dir/$policy_file" | awk '{print $1}') == "$policy_sha256" ]] || \
    error "$policy_file changed while the launch snapshot was being created"
  contract_commit=$(git_in_root rev-parse HEAD 2>/dev/null || printf '%s' unavailable)
  snapshot_file="$control_dir/contract_snapshot.tsv"
  printf '%s\t%s\n' \
    git_head "$contract_commit" \
    GOAL.md "$goal_sha256" \
    DATASETS.md "$datasets_sha256" \
    "$policy_file" "$policy_sha256" > "$snapshot_file"
  printf '%s\n' "starting" > "$launch_state"
  prompt=$(launch_prompt)
  set +e
  codex "${common_args[@]}" "$prompt"
  launch_status=$?
  set -e
  state_tmp="$control_dir/state.$$"
  if [[ $launch_status -eq 0 ]]; then
    printf '%s\n' "completed:0" > "$state_tmp"
  else
    printf '%s\n' "interrupted_or_failed:$launch_status" > "$state_tmp"
  fi
  mv -- "$state_tmp" "$launch_state"
  exit "$launch_status"
fi

[[ -d "$control_dir" ]] || error "resume requires an existing episode launch marker"
snapshot_dir="$control_dir/contract"
snapshot_file="$control_dir/contract_snapshot.tsv"
[[ -d "$snapshot_dir" && ! -L "$snapshot_dir" ]] || \
  error "resume requires the regular contract snapshot directory created at launch"
[[ -f "$snapshot_file" && ! -L "$snapshot_file" ]] || \
  error "resume requires the contract snapshot manifest created at launch"
snapshot_goal_sha256=$(awk -F '\t' '$1 == "GOAL.md" {print $2}' "$snapshot_file")
snapshot_datasets_sha256=$(awk -F '\t' '$1 == "DATASETS.md" {print $2}' "$snapshot_file")
snapshot_policy_sha256=$(awk -F '\t' -v policy="$policy_file" '$1 == policy {print $2}' "$snapshot_file")
[[ -n "$snapshot_goal_sha256" && -n "$snapshot_datasets_sha256" && -n "$snapshot_policy_sha256" ]] || \
  error "contract snapshot manifest is incomplete or names a different policy"
[[ $(sha256sum "$snapshot_dir/GOAL.md" | awk '{print $1}') == "$snapshot_goal_sha256" ]] || \
  error "snapshotted GOAL.md bytes changed"
[[ $(sha256sum "$snapshot_dir/DATASETS.md" | awk '{print $1}') == "$snapshot_datasets_sha256" ]] || \
  error "snapshotted DATASETS.md bytes changed"
[[ $(sha256sum "$snapshot_dir/$policy_file" | awk '{print $1}') == "$snapshot_policy_sha256" ]] || \
  error "snapshotted $policy_file bytes changed"
[[ $(sha256sum "$episode_dir/GOAL.md" | awk '{print $1}') == "$snapshot_goal_sha256" ]] || \
  error "live GOAL.md changed since launch; start a new episode run for the revised contract"
[[ $(sha256sum "$episode_dir/DATASETS.md" | awk '{print $1}') == "$snapshot_datasets_sha256" ]] || \
  error "live DATASETS.md changed since launch; start a new episode run for the revised contract"
[[ $(sha256sum "$episode_dir/$policy_file" | awk '{print $1}') == "$snapshot_policy_sha256" ]] || \
  error "live $policy_file changed since launch; start a new episode run for the revised contract"
session_binding="$control_dir/session_id"
[[ ! -L "$session_binding" ]] || error "local Codex session binding must not be a symlink"
if [[ -e "$session_binding" && ! -f "$session_binding" ]]; then
  error "local Codex session binding must be a regular file"
fi
if [[ -f "$session_binding" ]]; then
  IFS= read -r bound_session_id < "$session_binding" || \
    error "local Codex session binding is empty or unreadable"
  [[ -n "$bound_session_id" ]] || error "local Codex session binding is empty"
  [[ "$bound_session_id" == "$session_id" ]] || \
    error "episode is bound to a different Codex session id"
else
  bind_after_success=true
fi
resume_state="$control_dir/state"
printf '%s\n' "resuming" > "$resume_state"
prompt=$(resume_prompt)
set +e
codex resume "${common_args[@]}" "$session_id" "$prompt"
resume_status=$?
set -e
state_tmp="$control_dir/state.$$"
if [[ $resume_status -eq 0 ]]; then
  printf '%s\n' "completed:0" > "$state_tmp"
  if [[ ${bind_after_success:-false} == true ]]; then
    binding_tmp="$control_dir/session_id.$$"
    printf '%s\n' "$session_id" > "$binding_tmp"
    mv -- "$binding_tmp" "$session_binding"
  fi
else
  printf '%s\n' "interrupted_or_failed:$resume_status" > "$state_tmp"
fi
mv -- "$state_tmp" "$resume_state"
exit "$resume_status"
