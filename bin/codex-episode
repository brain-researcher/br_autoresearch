#!/usr/bin/env bash
# Thin launcher for one episode-scoped Codex task on Sherlock.

set -euo pipefail

usage() {
  printf '%s\n' >&2 \
    'Usage:' \
    '  bin/codex-episode launch <episode-dir>' \
    '  bin/codex-episode resume <episode-dir> <codex-session-id>'
  exit 2
}

error() {
  printf 'codex-episode: %s\n' "$*" >&2
  exit 2
}

mode=${1:-}
case "$mode" in
  launch) [[ $# -eq 2 ]] || usage ;;
  resume) [[ $# -eq 3 ]] || usage ;;
  *) usage ;;
esac

episode_arg=$2
session_id=${3:-}
[[ -n "$episode_arg" ]] || usage
if [[ "$mode" == "resume" ]]; then
  [[ -n "$session_id" && "$session_id" != -* && "$session_id" != *$'\n'* ]] || \
    error "resume requires one explicit session id"
fi

root_dir=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
if [[ "$episode_arg" == /* ]]; then
  episode_candidate=$episode_arg
else
  episode_candidate="$root_dir/$episode_arg"
fi

[[ -d "$episode_candidate" ]] || error "episode directory does not exist: $episode_candidate"
episode_dir=$(cd -P -- "$episode_candidate" && pwd)
[[ $(dirname -- "$episode_dir") == "$root_dir" ]] || \
  error "episode must be a direct child of $root_dir"

for required in GOAL.md DATASETS.md inputs outputs; do
  [[ -e "$episode_dir/$required" ]] || error "missing $required in $episode_dir"
done
[[ -f "$episode_dir/SEARCH_POLICY.yaml" || -f "$episode_dir/SEARCH_POLICY.json" ]] || \
  error "missing SEARCH_POLICY.yaml or SEARCH_POLICY.json in $episode_dir"

command -v codex >/dev/null 2>&1 || error "codex is not on PATH"
command -v flock >/dev/null 2>&1 || error "flock is required"
[[ -n ${SCRATCH:-} && "$SCRATCH" == /* && -d "$SCRATCH" && -w "$SCRATCH" ]] || \
  error "SCRATCH must be an absolute, existing, writable directory"

episode_name=$(basename -- "$episode_dir")
scratch_dir="$SCRATCH/autoresearch/$episode_name"
mkdir -p -- "$scratch_dir"
scratch_dir=$(cd -P -- "$scratch_dir" && pwd)

exec 9>"$episode_dir/outputs/.codex-episode.lock"
flock -n 9 || error "another Codex process is already active for $episode_name"

prompt=$(printf '%s\n' \
  "Work only on $episode_name in $episode_dir." \
  "Read $root_dir/AGENTS.md and the episode's GOAL.md, DATASETS.md, and search policy." \
  "Treat inputs/ as read-only, write episode artifacts under outputs/, use $scratch_dir for transient work, and do not modify sibling episodes.")

common_args=(
  --cd "$episode_dir"
  --add-dir "$scratch_dir"
  --sandbox workspace-write
  --ask-for-approval on-request
)
if [[ -n ${BR_AUTORESEARCH_CODEX_MODEL:-} ]]; then
  common_args+=(--model "$BR_AUTORESEARCH_CODEX_MODEL")
fi

if [[ "$mode" == "launch" ]]; then
  exec codex "${common_args[@]}" "$prompt"
fi
exec codex resume "${common_args[@]}" "$session_id" \
  "Resume the existing task. $prompt"
