#!/usr/bin/env python3
"""Display the read-only Cleanup A completion record."""

from __future__ import annotations

import argparse
import json
import pathlib
import sys
from typing import Any


ROOT = pathlib.Path(__file__).resolve().parent.parent
RECORD_PATH = ROOT / "DATA_CLEANUP_CANDIDATES.json"


def fail(message: str) -> None:
    raise SystemExit(f"data-cleanup failed: {message}")


def load_report() -> dict[str, Any]:
    with RECORD_PATH.open("r", encoding="utf-8") as stream:
        return json.load(stream)


def record_by_id(records: list[dict[str, Any]], logical_id: str) -> dict[str, Any]:
    for record in records:
        if record["logical_id"] == logical_id:
            return record
    fail(f"unknown logical ID: {logical_id}")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("list", help="list the five completed cleanup records")
    show = commands.add_parser("show", help="show one completed cleanup record")
    show.add_argument("logical_id")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    report = load_report()
    records = report["cleanup_records"]

    if args.command == "list":
        for record in records:
            print(
                f"{record['logical_id']}\tremoved\t"
                f"{record['estimated_reclaimed_bytes']}\t"
                f"{record['removed_path']}"
            )
        return 0

    record = record_by_id(records, args.logical_id)
    json.dump(record, sys.stdout, indent=2, sort_keys=True)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
