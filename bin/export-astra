#!/usr/bin/env python3
"""Thin entrypoint for Brain Researcher's validated episode ASTRA exporter."""

import sys

try:
    from brain_researcher.autoresearch.astra_workspace import main
except ModuleNotFoundError as exc:
    if exc.name and exc.name.startswith("brain_researcher"):
        print(
            "Brain Researcher with the 'astra' extra is required for bin/export-astra.",
            file=sys.stderr,
        )
        raise SystemExit(2) from exc
    raise


if __name__ == "__main__":
    raise SystemExit(main())
