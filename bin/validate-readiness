#!/bin/sh
'''exec' uv run --script "$0" "$@"
' '''
# /// script
# requires-python = ">=3.10"
# dependencies = [
#   "jsonschema==4.23.0",
#   "PyYAML==6.0.2",
# ]
# ///
"""Audit optional canonical-confirmation projections.

This tool is not called by bin/codex-episode and does not authorize or block
episode-managed local execution.
"""

import json
import argparse
import copy
import hashlib
import pathlib
import sys
from typing import Any

import jsonschema
import yaml


class UniqueKeyLoader(yaml.SafeLoader):
    pass


def _construct_mapping(loader: UniqueKeyLoader, node: yaml.MappingNode, deep: bool = False) -> dict[str, Any]:
    mapping: dict[str, Any] = {}
    for key_node, value_node in node.value:
        key = loader.construct_object(key_node, deep=deep)
        if key in mapping:
            raise ValueError(f"duplicate YAML key: {key!r}")
        mapping[key] = loader.construct_object(value_node, deep=deep)
    return mapping


UniqueKeyLoader.add_constructor(
    yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG,
    _construct_mapping,
)


def load_yaml(path: pathlib.Path) -> Any:
    with path.open("r", encoding="utf-8") as stream:
        return yaml.load(stream, Loader=UniqueKeyLoader)


def _unique_json_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    mapping: dict[str, Any] = {}
    for key, value in pairs:
        if key in mapping:
            raise ValueError(f"duplicate JSON key: {key!r}")
        mapping[key] = value
    return mapping


def load_policy(path: pathlib.Path) -> Any:
    """Load the registry-selected policy without assuming a YAML filename."""

    if path.suffix == ".json":
        with path.open("r", encoding="utf-8") as stream:
            return json.load(stream, object_pairs_hook=_unique_json_object)
    if path.suffix in {".yaml", ".yml"}:
        return load_yaml(path)
    fail(f"unsupported SEARCH_POLICY suffix: {path.suffix or '<none>'}")


def fail(message: str) -> None:
    raise SystemExit(f"readiness validation failed: {message}")


def validate_schema_transition_fixtures(readiness: dict[str, Any], schema: dict[str, Any]) -> None:
    provisioning_unblocked = copy.deepcopy(readiness)
    provisioning_unblocked["episodes"][0]["compatibility"] = {
        "launch_blocked": False,
        "launch_eligible": True,
    }
    try:
        jsonschema.validate(provisioning_unblocked, schema)
    except jsonschema.ValidationError:
        pass
    else:
        fail("schema accepted a non-canonical-ready episode as launch eligible")

    ready_without_receipt = copy.deepcopy(readiness)
    ready_without_receipt["episodes"][0]["readiness"]["state"] = "canonical_ready"
    ready_without_receipt["episodes"][0]["compatibility"] = {
        "launch_blocked": False,
        "launch_eligible": True,
    }
    ready_without_receipt["episodes"][0]["canonical_binding"] = None
    try:
        jsonschema.validate(ready_without_receipt, schema)
    except jsonschema.ValidationError:
        pass
    else:
        fail("schema accepted canonical_ready without a binding receipt")

    ready_with_receipt = copy.deepcopy(readiness)
    ready_item = ready_with_receipt["episodes"][0]
    ready_item["readiness"]["state"] = "canonical_ready"
    ready_item["compatibility"] = {"launch_blocked": False, "launch_eligible": True}
    ready_item["canonical_binding"] = {
        "authority": "Brain Researcher MCP",
        "episode_id": ready_item["episode_id"],
        "program_id": "program_fixture",
        "program_version": "fixture-v1",
        "policy_ref": f"{ready_item['path']}/SEARCH_POLICY.yaml",
        "policy_sha256": "0" * 64,
        "contract_revision": 1,
        "contract_manifest_sha256": "1" * 64,
        "git_commit": "2" * 40,
        "receipt_id": "receipt_fixture",
        "receipt_ref": "fixture://canonical-binding",
        "verified_at": "2026-09-22T00:00:00Z",
    }
    jsonschema.validate(ready_with_receipt, schema)

    running_with_receipt = copy.deepcopy(ready_with_receipt)
    running_item = running_with_receipt["episodes"][0]
    running_item["execution"]["state"] = "development_running"
    running_item["compatibility"] = {"launch_blocked": True, "launch_eligible": False}
    jsonschema.validate(running_with_receipt, schema)

    running_without_binding = copy.deepcopy(readiness)
    running_without_binding["episodes"][0]["execution"]["state"] = "development_running"
    jsonschema.validate(running_without_binding, schema)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--episode-id")
    parser.add_argument("--episode-path")
    parser.add_argument(
        "--require-stage",
        choices=[
            "development_ready",
            "audit_ready",
            "canonical_preflight_ready",
            "canonical_ready",
        ],
    )
    args = parser.parse_args()
    if args.episode_id and args.episode_path:
        fail("use only one of --episode-id and --episode-path")
    if args.require_stage and not (args.episode_id or args.episode_path):
        fail("--require-stage requires --episode-id or --episode-path")

    root = pathlib.Path(__file__).resolve().parent.parent
    readiness_path = root / "EPISODE_READINESS.yaml"
    registry_path = root / "EPISODE_REGISTRY.yaml"

    readiness = load_yaml(readiness_path)
    registry = load_yaml(registry_path)
    with (root / "EPISODE_READINESS.schema.json").open("r", encoding="utf-8") as stream:
        readiness_schema = json.load(stream)
    with (root / "EPISODE_REGISTRY.schema.json").open("r", encoding="utf-8") as stream:
        registry_schema = json.load(stream)
    with (root / "EPISODE_READINESS_MANIFEST.schema.json").open("r", encoding="utf-8") as stream:
        manifest_schema = json.load(stream)
    with (root / "SEARCH_POLICY.schema.json").open("r", encoding="utf-8") as stream:
        policy_schema = json.load(stream)

    jsonschema.Draft202012Validator.check_schema(readiness_schema)
    jsonschema.Draft202012Validator.check_schema(registry_schema)
    jsonschema.Draft202012Validator.check_schema(manifest_schema)
    jsonschema.validate(readiness, readiness_schema)
    jsonschema.validate(registry, registry_schema)
    validate_schema_transition_fixtures(readiness, readiness_schema)

    if registry.get("schema_version") != "autoresearch.episode_registry.v2":
        fail("EPISODE_REGISTRY.yaml is not v2")
    if registry.get("readiness_model_ref") != "READINESS_MODEL.yaml":
        fail("registry readiness_model_ref mismatch")
    if registry.get("readiness_ledger_ref") != "EPISODE_READINESS.yaml":
        fail("registry readiness_ledger_ref mismatch")

    registry_episodes = registry.get("episodes", [])
    readiness_episodes = readiness.get("episodes", [])
    registry_by_id = {item["episode_id"]: item for item in registry_episodes}
    readiness_by_id = {item["episode_id"]: item for item in readiness_episodes}
    if len(registry_by_id) != len(registry_episodes):
        fail("duplicate episode_id in registry")
    if len(readiness_by_id) != len(readiness_episodes):
        fail("duplicate episode_id in readiness ledger")
    if set(registry_by_id) != set(readiness_by_id):
        missing_readiness = sorted(set(registry_by_id) - set(readiness_by_id))
        missing_registry = sorted(set(readiness_by_id) - set(registry_by_id))
        fail(
            f"episode-set mismatch; missing readiness={missing_readiness}, "
            f"missing registry={missing_registry}"
        )

    policy_validator = jsonschema.Draft202012Validator(policy_schema)
    stage_order = [
        "development_ready",
        "audit_ready",
        "canonical_preflight_ready",
        "canonical_ready",
    ]
    critical_gates = {
        "contract",
        "source_integrity",
        "scientific_freeze",
        "development_handoff",
        "controller",
        "audit_identity",
        "audit_boundary",
        "trusted_evaluator",
        "compute_profile",
        "identity_collision",
        "canonical_program",
    }
    canonical_ready_items: list[dict[str, Any]] = []
    for episode_id in sorted(registry_by_id):
        registry_item = registry_by_id[episode_id]
        readiness_item = readiness_by_id[episode_id]
        if registry_item["path"] != readiness_item["path"]:
            fail(f"{episode_id}: path mismatch")
        if registry_item.get("launch_blocked") != readiness_item["compatibility"]["launch_blocked"]:
            fail(f"{episode_id}: legacy launch_blocked projection mismatch")
        if registry_item.get("canonical_binding") != readiness_item.get("canonical_binding"):
            fail(f"{episode_id}: registry/readiness canonical binding mismatch")

        episode_dir = root / registry_item["path"]
        for required in ("GOAL.md", "DATASETS.md", "inputs", "outputs"):
            if not (episode_dir / required).exists():
                fail(f"{episode_id}: missing {required}")

        policy_path = root / registry_item["search_policy_ref"]
        if not policy_path.is_file():
            fail(f"{episode_id}: missing registered SEARCH_POLICY: {policy_path}")
        try:
            policy_path.resolve().relative_to(episode_dir.resolve())
        except ValueError:
            fail(f"{episode_id}: registered SEARCH_POLICY is outside episode directory")
        policy = load_policy(policy_path)
        errors = sorted(policy_validator.iter_errors(policy), key=lambda error: list(error.path))
        if errors:
            first = errors[0]
            fail(f"{episode_id}: SEARCH_POLICY schema error at {list(first.path)}: {first.message}")
        if policy.get("episode_id") != episode_id:
            fail(f"{episode_id}: SEARCH_POLICY episode_id mismatch")
        # SEARCH_POLICY is the immutable object eventually bound by hash. Its
        # legacy state fields deliberately remain at their authoring values;
        # promotion state lives only in the readiness/registry projections.

        staged_states = {
            "development_ready",
            "audit_ready",
            "canonical_preflight_ready",
            "canonical_ready",
        }

        manifest_ref = readiness_item["readiness"].get("manifest_ref")
        observed_readiness = readiness_item["readiness"]["state"]
        if observed_readiness in staged_states and manifest_ref is None:
            fail(f"{episode_id}: {observed_readiness} requires a readiness manifest")
        if manifest_ref is not None:
            manifest_path = root / manifest_ref
            if not manifest_path.is_file():
                fail(f"{episode_id}: readiness manifest does not exist: {manifest_ref}")
            try:
                manifest_path.resolve().relative_to(episode_dir.resolve())
            except ValueError:
                fail(f"{episode_id}: readiness manifest is outside episode directory")
            manifest = load_yaml(manifest_path)
            jsonschema.validate(manifest, manifest_schema)
            if manifest.get("episode_id") != episode_id:
                fail(f"{episode_id}: readiness manifest episode_id mismatch")
            if manifest.get("readiness_state") != readiness_item["readiness"]["state"]:
                fail(f"{episode_id}: readiness manifest readiness_state mismatch")
            if manifest.get("execution_state") != readiness_item["execution"]["state"]:
                fail(f"{episode_id}: readiness manifest execution_state mismatch")
            if manifest.get("evidence_status") != readiness_item["evidence"]["status"]:
                fail(f"{episode_id}: readiness manifest evidence_status mismatch")

            required_gates_by_stage = {
                "development_ready": {
                    "contract",
                    "source_integrity",
                    "scientific_freeze",
                    "shared_evidence",
                    "development_handoff",
                    "controller",
                    "audit_identity",
                    "trusted_evaluator",
                    "compute_profile",
                },
                "audit_ready": {"audit_boundary"},
                "canonical_preflight_ready": {"identity_collision"},
                "canonical_ready": {"canonical_program"},
            }
            observed_stage = manifest["readiness_state"]
            if observed_stage in stage_order:
                required_gates: set[str] = set()
                for stage in stage_order[: stage_order.index(observed_stage) + 1]:
                    required_gates.update(required_gates_by_stage[stage])
                for gate_name in sorted(required_gates):
                    gate = manifest["summary_gates"][gate_name]
                    if gate["status"] not in {"passed", "not_applicable"}:
                        fail(f"{episode_id}: {observed_stage} requires passed gate {gate_name}")
                    if gate["status"] == "not_applicable" and gate_name in critical_gates:
                        fail(f"{episode_id}: critical gate {gate_name} cannot be not_applicable")
                    if gate["status"] == "passed" and not gate["evidence_refs"]:
                        fail(f"{episode_id}: passed gate {gate_name} lacks evidence_refs")
                    if gate["status"] == "not_applicable" and not gate.get("rationale"):
                        fail(f"{episode_id}: not_applicable gate {gate_name} lacks rationale")

                    for evidence_ref in gate["evidence_refs"]:
                        if "://" in evidence_ref:
                            if gate_name != "canonical_program":
                                fail(f"{episode_id}: URI evidence is allowed only for canonical_program")
                            continue
                        evidence_path = pathlib.Path(evidence_ref)
                        if not evidence_path.is_absolute():
                            evidence_path = manifest_path.parent / evidence_path
                        if not evidence_path.exists():
                            fail(f"{episode_id}: evidence reference does not exist: {evidence_ref}")

            if observed_readiness == "canonical_ready":
                canonical_ready_items.append(readiness_item)
                binding = readiness_item["canonical_binding"]
                if binding["authority"] != "Brain Researcher MCP":
                    fail(f"{episode_id}: canonical receipt authority mismatch")
                if binding["episode_id"] != episode_id:
                    fail(f"{episode_id}: canonical receipt episode_id mismatch")
                expected_policy_ref = registry_item["search_policy_ref"]
                if binding["policy_ref"] != expected_policy_ref:
                    fail(f"{episode_id}: canonical receipt policy_ref mismatch")
                observed_policy_sha = hashlib.sha256(policy_path.read_bytes()).hexdigest()
                if binding["policy_sha256"] != observed_policy_sha:
                    fail(f"{episode_id}: canonical receipt does not bind exact policy bytes")
                receipt_ref = binding["receipt_ref"]
                if receipt_ref not in manifest["summary_gates"]["canonical_program"]["evidence_refs"]:
                    fail(f"{episode_id}: canonical gate does not cite its binding receipt")

                # No trusted Brain Researcher receipt verifier is currently
                # deployed in this repository. Local YAML strings, even when
                # self-consistent, must never manufacture canonical authority.
                fail(
                    f"{episode_id}: canonical_ready requires the unavailable trusted "
                    "Brain Researcher receipt verifier"
                )

        if observed_readiness == "canonical_ready" and readiness_item["blocking_classes"]:
            fail(f"{episode_id}: canonical_ready retains blocking_classes")
        allowed_future_blockers = {
            "development_ready": {"audit_boundary", "identity_collision", "canonical_program"},
            "audit_ready": {"identity_collision", "canonical_program"},
            "canonical_preflight_ready": {"canonical_program"},
            "canonical_ready": set(),
        }
        if observed_readiness in allowed_future_blockers:
            unexpected_blockers = set(readiness_item["blocking_classes"]) - allowed_future_blockers[observed_readiness]
            if unexpected_blockers:
                fail(
                    f"{episode_id}: {observed_readiness} retains resolved-stage blockers "
                    f"{sorted(unexpected_blockers)}"
                )

    review_queue = readiness.get("review_queue", [])
    if set(review_queue) != set(readiness_by_id) or len(review_queue) != len(readiness_by_id):
        fail("review_queue must contain every formal episode exactly once")
    active = readiness.get("active_episode_review")
    if active is not None and active not in readiness_by_id:
        fail("active_episode_review is not a formal episode")
    if review_queue and active != review_queue[0]:
        fail("active_episode_review must equal the first review_queue entry")

    locally_advanced = [
        item
        for item in readiness_episodes
        if item["execution"]["state"] == "not_started"
        and item["readiness"]["state"] in stage_order
    ]
    if len(locally_advanced) > 1:
        fail("only one unlaunched episode may be advanced beyond provisioning")
    if locally_advanced and locally_advanced[0]["episode_id"] != active:
        fail("only the active episode may advance beyond provisioning")

    if canonical_ready_items and any(
        blocker.get("class") == "canonical_program"
        for blocker in readiness.get("portfolio_blockers", [])
    ):
        fail("canonical_ready conflicts with an unresolved portfolio canonical_program blocker")

    selected = None
    if args.episode_id:
        selected = readiness_by_id.get(args.episode_id)
        if selected is None:
            fail(f"unknown formal episode: {args.episode_id}")
    elif args.episode_path:
        matches = [item for item in readiness_episodes if item["path"] == args.episode_path]
        if len(matches) != 1:
            fail(f"episode path is not uniquely registered: {args.episode_path}")
        selected = matches[0]

    if selected is not None and args.require_stage:
        acceptable = {
            "development_ready": {
                "development_ready",
                "audit_ready",
                "canonical_preflight_ready",
                "canonical_ready",
            },
            "audit_ready": {"audit_ready", "canonical_preflight_ready", "canonical_ready"},
            "canonical_preflight_ready": {"canonical_preflight_ready", "canonical_ready"},
            "canonical_ready": {"canonical_ready"},
        }
        observed = selected["readiness"]["state"]
        if observed not in acceptable[args.require_stage]:
            fail(
                f"{selected['episode_id']}: requires {args.require_stage}, "
                f"observed {observed}"
            )

    print(
        f"readiness validation passed: {len(readiness_by_id)} formal episodes; "
        f"active review={active}; canonical_ready="
        f"{sum(item['readiness']['state'] == 'canonical_ready' for item in readiness_episodes)}"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
