  "goal": "Focused standalone EP10 methodological review: after correcting an M1 directional-derivative implementation to the already-frozen candidate-level summation rule, which historical numerical qualifications and fitted-model results can still be reused? Preserve objective, full gradient, Hessian, optimizer, convergence and acceptance rules, original data roles and budget. Assess whether the existing mandatory 36-fit synthetic warm-repeat/zero-start qualification may run in parallel with the ongoing bounded failed-probe replay, and whether a changed accepted-step sequence requires clean M1 refitting before comparing M2. Do not authorize outcomes or amendments. Review only provided contract/code evidence; no protected data.",
  "hints": {
    "analysis_type": "exact conditional fixed-K penalized set-softmax; nested grouped prediction; binary64 numerical conformance repair",
    "scope": "target-free execution planning and qualification reuse; no biological results",
    "decision_constraints": [
      "No acceptance relaxation",
      "No stale numerical certificate for changed code",
      "Reuse genuinely unaffected rank/data/geometry evidence",
      "No wholesale audit or unnecessary synthetic work",
      "Formal Society and canonical acceptance out of scope"
    ]
  },
  "tailored_checks": [],
  "evaluation_axes": {
    "correctness": {
      "decision_space": [
        "pass",
        "flag",
        "block"
      ],
      "criteria": [
        "Confirm the statistical/analytic specification matches the declared research question.",
        "Verify the design matrix / model structure is well-posed (no rank deficiency, no collinear nuisance regressors).",
        "Check contrast definitions match the reported hypotheses and their dimensions.",
        "Verify cross-file consistency between events, confounds, and model spec (subjects/runs align)."
      ],
      "required_outputs": [
        "decision",
        "findings[]"
      ]
    },
    "completeness": {
      "decision_space": [
        "complete",
        "incomplete"
      ],
      "criteria": [
        "Random seed is pinned and reported.",
        "Atlas / parcellation version is declared when atlas-based features are used.",
        "Ordering of conditions / trials / factors is explicitly declared.",
        "Multiple-comparisons strategy (FWE / FDR / cluster threshold) is stated.",
        "Preprocessing provenance (motion scrubbing, confound regression, smoothing) is reported."
      ],
      "required_outputs": [
        "decision",
        "checklist{}",
        "missing_caveats[]"
      ]
    },
    "judgment": {
      "decision_space": [
        "sound",
        "questionable",
        "unsound"
      ],
      "criteria": [
        "The estimand is clearly specified (population, unit, causal vs. associational).",
        "The chosen method is defensible for that estimand, not just conventional.",
        "Known threats to validity are acknowledged (confounds, selection, measurement).",
        "Effect sizes and uncertainty are reported, not just p-values."
      ],
      "required_outputs": [
        "decision",
        "estimand_complete",
        "method_defensible",
        "issues[]",
        "reviewer_questions[]"
      ]
    },
    "overall": {
      "decision_space": [
        "proceed",
        "diagnose",
        "explore_more",
        "stop_with_rationale"
      ],
      "criteria": [
        "Synthesize correctness + completeness + judgment into a single overall_decision.",
        "Blocking correctness issues -> stop_with_rationale.",
        "Non-blocking structural correctness flags -> diagnose.",
        "Unsound judgment -> diagnose.",
        "Questionable judgment OR incomplete completeness -> explore_more.",
        "Otherwise -> proceed."
      ],
      "required_outputs": [
        "overall_decision",
        "report_action"
      ]
    }
  },
